{
  "name": "puppet-master",
  "version": "1.0.0",
  "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:unit": "jest",
    "test:infra": "bash scripts/terraform-validate.sh",
    "dev": "concurrently -n \"api,frontend\" -c \"blue,green\" \"pnpm run dev:api\" \"pnpm run dev:frontend\"",
    "dev:api": "node --env-file=.env --watch src/index.ts",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "mastra build",
    "build:frontend": "pnpm --filter frontend build",
    "build:all": "pnpm run build && pnpm run build:frontend",
    "install:frontend": "pnpm --filter frontend install",
    "start": "NODE_ENV=production node src/index.ts",
    "format": "prettier --write .",
    "check": "tsc --noEmit",
    "init:knowledge-base": "node --env-file=.env src/mastra/rag/init-knowledge-base.ts",
    "init:knowledge-base:enhanced": "node --env-file=.env src/mastra/rag/init-knowledge-base-enhanced.ts",
    "update:news": "node --env-file=.env src/mastra/rag/update-news-index.ts",
    "db:start": "docker compose  --env-file .env up"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.32",
    "@ai-sdk/openai": "^2.0.67",
    "@elevenlabs/elevenlabs-js": "^2.24.1",
    "@google/generative-ai": "^0.24.1",
    "@hono/node-server": "^1.19.6",
    "@mastra/core": "1.0.0-beta.2",
    "@mastra/evals": "1.0.0-beta.0",
    "@mastra/libsql": "1.0.0-beta.0",
    "@mastra/loggers": "1.0.0-beta.0",
    "@mastra/memory": "1.0.0-beta.0",
    "@mastra/pg": "1.0.0-beta.0",
    "@mastra/voice-elevenlabs": "^0.11.12",
    "@types/ws": "^8.18.1",
    "ai": "^5.0.93",
    "hono": "^4.10.6",
    "pg": "^8.13.1",
    "react": "^19.2.0",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.5",
    "concurrently": "^9.2.1",
    "jest": "^30.2.0",
    "mastra": "1.0.0-beta.1",
    "prettier": "^3.6.2",
    "ts-jest": "^29.3.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
