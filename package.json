  "scripts": {
    "test": "node --env-file=.env src/test-game.ts",
    "test:game": "node --env-file=.env src/test-game.ts",
    "dev": "concurrently \"pnpm:dev:backend\" \"pnpm:dev:frontend\"",
    "dev:backend": "mastra dev",
    "dev:frontend": "cd frontend && pnpm dev",
    "build": "mastra build && cd frontend && pnpm build",
    "start": "mastra start",
    "format": "prettier --write .",
    "check": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
