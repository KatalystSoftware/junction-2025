    "@mastra/evals": "1.0.0-beta.0",
    "@mastra/libsql": "1.0.0-beta.0",
    "@mastra/loggers": "1.0.0-beta.0",
    "@mastra/memory": "1.0.0-beta.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "concurrently": "^9.2.1",
    "mastra": "1.0.0-beta.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
